# NeuralBlitz v50.0 - Omega Singularity Intelligence
# Python Base Image
FROM python:3.11-slim

# Metadata
LABEL maintainer="NeuralBlitz Contributors"
LABEL version="v50.0.0"
LABEL description="NeuralBlitz Python Implementation - Omega Singularity Architecture"

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NEURALBLITZ_VERSION=v50.0.0
ENV NEURALBLITZ_COHERENCE=1.0
ENV GOLDEN_DAG_SEED=a8d0f2a4c6b8d0f2a4c6b8d0f2a4c6b8d0f2a4c6b8d0f2a4c6b8d0f2a4c6b8d0

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Python source code
COPY python/ .

# Create non-root user
RUN useradd -m -u 1000 neuralblitz && chown -R neuralblitz:neuralblitz /app
USER neuralblitz

# This image defaults to a one-shot CLI, not a long-running service.
# Do not declare an import-only HEALTHCHECK: it cannot measure API readiness.
# An API-specific image should define a health probe for its running endpoint.

# Show supported CLI commands by default (there is no `version` subcommand).
CMD ["python", "-m", "neuralblitz.cli", "--help"]

# For Option F (API Server), override CMD:
# docker run -p 8080:8080 neuralblitz:v50.0 python -m neuralblitz.cli serve --port 8080
