{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ReflexælLang (provisional lexical highlighting)",
  "scopeName": "source.reflexaellang",
  "fileTypes": [
    "rfxl",
    "rl"
  ],
  "patterns": [
    {
      "name": "string.quoted.double.reflexaellang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.reflexaellang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.reflexaellang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.reflexaellang",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.reflexaellang",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    }
  ]
}
