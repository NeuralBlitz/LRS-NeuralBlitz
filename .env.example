# Copy to .env and replace every value with unique, strong local secrets.
# Never commit .env.
INFLUXDB_ADMIN_USER=replace-me
INFLUXDB_ADMIN_PASSWORD=replace-me-with-a-long-random-password
INFLUXDB_USER=replace-me
INFLUXDB_USER_PASSWORD=replace-me-with-a-long-random-password
INFLUXDB_ADMIN_TOKEN=replace-me-with-a-long-random-token
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
GRAFANA_ADMIN_USER=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-long-random-password

# Optional published host bindings for local development (loopback is the default).
# To permit remote access, explicitly set one of these addresses only after
# configuring authentication, firewalls, TLS and trusted network boundaries.
# INFLUXDB_BIND_ADDRESS=127.0.0.1
# TIMESCALEDB_BIND_ADDRESS=127.0.0.1
# PROMETHEUS_BIND_ADDRESS=127.0.0.1
# GRAFANA_BIND_ADDRESS=127.0.0.1
# NODE_EXPORTER_BIND_ADDRESS=127.0.0.1
# CADVISOR_BIND_ADDRESS=127.0.0.1
