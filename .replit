# Source-preview workspace only; this does NOT deploy a production AI platform.
# The Node entrypoint serves only a truthful static status/health page.
run = "HOST=0.0.0.0 node index.js"
entrypoint = "index.js"
modules = ["nodejs-22", "python-3.11"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "index.js", "package.json", "bun.lock"]

[nix]
channel = "stable-24_11"
packages = ["libxcrypt"]

[agent]
expertMode = true

[[ports]]
localPort = 8000
externalPort = 80
