# Development helper only. No deployable Replit web application exists yet.
# The run command intentionally exits with an actionable explanation.
entrypoint = "index.js"
run = ["node", "index.js"]
modules = ["nodejs-22", "python-3.11"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "package.json", "bun.lock", "index.js"]

[nix]
channel = "stable-24_11"
packages = ["libxcrypt"]

[agent]
expertMode = true

# No [deployment] or [[ports]] advertised: this is not a running service.
